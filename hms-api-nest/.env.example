# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database (schema + seed live in database/hms.sql)
PGHOST=localhost
PGPORT=5432
PGDATABASE=hms_db
PGUSER=postgres
PGPASSWORD=your_password_here

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=24h

# Email reminders
# Leave SMTP_HOST blank in dev — the server will spin up a free Ethereal sandbox
# account on boot. Sent emails are NOT delivered to real inboxes; instead each
# message comes back with a preview URL the UI surfaces in a toast.
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_SECURE=false
#SMTP_USER=
#SMTP_PASS=
#SMTP_FROM=HMS <no-reply@hms.lb>

# How far ahead the cron sweep looks for upcoming appointments (default 24h)
#REMINDER_HORIZON_HOURS=24
